# Required. Transaction pooler (port 6543) — Vercel API queries.
# Supabase → Project Settings → Database → Connection string → URI → Transaction pooler
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional. Do NOT set this to db.<ref>.supabase.co — that host is IPv6-only
# and fails on Vercel (ENOTFOUND). Schema creation uses session pooler (5432)
# derived from DATABASE_URL automatically.
