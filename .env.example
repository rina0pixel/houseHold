# Runtime queries (Vercel serverless) — Transaction pooler, port 6543
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Table creation (DDL) — Direct connection, port 5432 (recommended)
# Supabase dashboard → Project Settings → Database → Connection string → Direct
DATABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# If you only set DATABASE_URL, the app auto-uses session pooler (5432) for
# schema migration. DATABASE_DIRECT_URL is more reliable on the free plan.
