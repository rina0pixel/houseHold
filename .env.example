# Copy to .env.local and fill in your Supabase connection string to use
# Supabase instead of local SQLite during development.
#
# Supabase dashboard → Project Settings → Database → Connection string
# → URI → Transaction pooler (port 6543, recommended for serverless)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
